  title={Fault Analysis and Design Trade-Offs In Networked Cyber Physical Systems: A Formal Method-Based Approach},
  author={Denker, Grit and Qin, Zhijing and Elenius, Daniel and Talcott, Carolyn and Venkatasubramanian, Nalini}, 
