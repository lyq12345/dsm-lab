  title={Metasim: Reflective Middleware Solutions for Simulation Integration},
  author={Jalali, Leila and Balasubramanian, Vidhya and Venkatasubramanian, Nalini and Mehrotra, Sharad},
  booktitle={ACM/IFIP/USENIX Middleware},
